model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: nl-BE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup _params

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["pg_server","pg_database","budget_file","gold dim_campaign","gold dim_channel","gold dim_country","gold dim_customer","gold dim_date","gold dim_email","gold dim_product","gold dim_subscriber","gold fct_ad_performance","gold fct_customer_rfm_monthly","gold fct_email_sends","gold fct_marketing_spend","gold fct_order_lines","gold fct_order_touchpoints","gold fct_orders","gold fct_returns","gold fct_web_traffic"]

ref table 'gold dim_campaign'
ref table 'gold dim_channel'
ref table 'gold dim_country'
ref table 'gold dim_customer'
ref table 'gold dim_date'
ref table 'gold dim_email'
ref table 'gold dim_product'
ref table 'gold dim_subscriber'
ref table 'gold fct_ad_performance'
ref table 'gold fct_customer_rfm_monthly'
ref table 'gold fct_email_sends'
ref table 'gold fct_marketing_spend'
ref table 'gold fct_order_lines'
ref table 'gold fct_order_touchpoints'
ref table 'gold fct_orders'
ref table 'gold fct_returns'
ref table 'gold fct_web_traffic'

ref cultureInfo en-US

