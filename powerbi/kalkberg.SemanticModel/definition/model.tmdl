annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["pg_server","pg_database","budget_file","Campaign","Channel","Country","Customer","Date","Email","Product","Subscriber","AdPerformance","CustomerMonthlyRFM","EmailSends","MarketingSpend","OrderLines","OrderTouchpoints","Orders","Returns","WebTraffic"]

